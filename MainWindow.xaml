<Window x:Class="PdfToOcrWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfToOcrWpf.ViewModels"
        Title="PDF to OCR to TXT"
        Width="760" Height="620" MinWidth="720" MinHeight="580"
        Background="#F4F6F8"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="8" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Background" Value="#93B4F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>

            <TextBlock Text="PDF to OCR to TXT"
                       FontSize="22" FontWeight="Bold" Foreground="#1F2D3D"/>
            <TextBlock Foreground="#6B7785" FontSize="12" Margin="0,4,0,16"
                       TextWrapping="Wrap"
                       Text="Convertit chaque page du PDF en image, extrait le texte avec Tesseract, et l'écrit dans un fichier .txt unique."/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="0. Exécutable Tesseract" Style="{StaticResource CardTitle}"/>
                    <TextBox Text="{Binding TesseractExePath, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6" VerticalContentAlignment="Center"/>
                    <TextBlock Foreground="#6B7785" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="Chemin complet vers tesseract.exe. Le dossier doit contenir un sous-dossier tessdata/."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="1. Fichier PDF source" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button Content="Parcourir…" DockPanel.Dock="Right"
                                Command="{Binding BrowsePdfCommand}"
                                Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding PdfPath, Mode=OneWay}" IsReadOnly="True"
                                 Padding="6" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="2. Fichier texte de sortie" Style="{StaticResource CardTitle}"/>
                    <DockPanel>
                        <Button Content="Enregistrer sous…" DockPanel.Dock="Right"
                                Command="{Binding BrowseTxtCommand}"
                                Padding="12,6" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding TxtPath, Mode=OneWay}" IsReadOnly="True"
                                 Padding="6" VerticalContentAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="3. Options OCR" Style="{StaticResource CardTitle}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Langue :" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding Language}"
                                  Width="110" Margin="6,0,24,0"/>

                        <TextBlock Text="DPI :" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Dpis}"
                                  SelectedItem="{Binding Dpi}"
                                  Width="80" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="4. Progression" Style="{StaticResource CardTitle}"/>
                    <ProgressBar Height="18"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMax}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Foreground="#2563EB" Background="#E5E7EB"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="#374151"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="▶  Démarrer la conversion"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding StartCommand}"/>
                <Button Content="✕  Annuler"
                        Command="{Binding CancelCommand}"
                        Padding="16,8" Margin="8,0,0,0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
